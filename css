/* style.css */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial, sans-serif;
  background:#0b0f19;
  color:white;
  line-height:1.6;
}

header{
  background:#00c853;
  padding:30px;
  text-align:center;
}

header h1{
  font-size:2.2rem;
}

header p{
  margin-top:10px;
}

main{
  padding:20px;
  max-width:1000px;
  margin:auto;
}

.card{
  background:#161d2e;
  padding:20px;
  margin-bottom:20px;
  border-radius:12px;
  box-shadow:0 0 10px rgba(0,0,0,0.4);
}

.card h2{
  margin-bottom:15px;
  color:#00e676;
}

ul{
  list-style:none;
}

ul li{
  margin-bottom:10px;
}

pre{
  background:black;
  padding:15px;
  overflow:auto;
  border-radius:10px;
  color:#00ff90;
}

.features{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:15px;
}

.feature-box{
  background:#00c853;
  color:black;
  padding:20px;
  text-align:center;
  border-radius:10px;
  font-weight:bold;
}

button{
  background:#00e676;
  color:black;
  border:none;
  padding:15px 25px;
  border-radius:10px;
  cursor:pointer;
  font-size:1rem;
  font-weight:bold;
}

button:hover{
  background:#69f0ae;
}

#status{
  font-size:1.3rem;
  font-weight:bold;
  color:#00ff90;
}

footer{
  text-align:center;
  padding:20px;
  background:#111;
}
